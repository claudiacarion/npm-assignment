<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <%- include('../partials/header.ejs') %>
    <main class="main-container">
      <h1 class="page-title animate__animated animate__fadeIn" style="background-image: linear-gradient(var(--main-color-overlay), var(--main-color-overlay)), url('<%= locals.selected ? selected[0].background : background %>')"><%= title %></h1> 
      <% if (locals.type) { %>
        <% if (type === "page") { %>
          <%- include('../partials/mainpage.ejs') %>
        <% } %>
        <% if (type === "subpage") { %>
          <%- include('../partials/subpage.ejs') %>
        <% } %>
      <% } %>
    </main>
    <%- include('../partials/footer.ejs') %>
  </body>
</html>